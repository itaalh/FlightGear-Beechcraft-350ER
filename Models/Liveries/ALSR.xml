  window-plug-l1: the first cabin window on the left side is plugged on this aircraft (Models/KingAir.xml).
-->

<PropertyList>
  <sim>
    <model>
      <livery>
        <name type="string">Armée de l'Air - ALSR Vador 1030 F-RACH</name>
        <index type="int">6</index>
        <window-plug-l1 type="bool">true</window-plug-l1>
        <bodyWork>
          <texture>Liveries/ALSR.png</texture>
        </bodyWork>
      </livery>
    </model>
  </sim>
</PropertyList>
