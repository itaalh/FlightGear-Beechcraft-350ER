<?xml version="1.0" encoding="UTF-8"?>
<!--
  King Air 350ER "G1000" variant (KingAir-350ER-G1000-set.xml): the standard model plus three Garmin GDU 1044B displays
  (FG1000 from FGData, $FG_ROOT/Aircraft/Instruments-3d/FG1000) in line across the instrument panel, as in the
  G1000 NXi retrofits of the King Air 350: pilot PFD, MFD in the middle, copilot PFD.

  Panel face (model frame, x aft +, y right +, z up +): x = -4.647 m, instruments between z 0.04 and 0.34.
  PFD 1 centred on the pilot's EFIS column (y -0.425), MFD over the COM1/NAV1 radio stack (y +0.01),
  PFD 2 (FG1000 display 3) centred on the copilot's EFIS column (y +0.445).
  Models/G1000-panel.ac is the flat panel face around the displays: it covers the old flight instruments, the
  radio heads and the engine gauge column (the engines are on the MFD EIS strip). The covered objects are hidden
  by a select animation in Models/flightdeck.xml.
  Both are shown only when the FG1000 was found (sim/model/g1000/enabled, Nasal/fg1000-kingair.nas); otherwise
  the original instruments stay in view.
  The display offsets can be nudged live with the properties sim/model/g1000/pfd|mfd|pfd2/dx-m|dy-m|dz-m
  (property browser), then written back here.
-->
<PropertyList>

  <model>
    <name>KingAir</name>
    <path>Aircraft/KingAir-350/Models/KingAir.xml</path>
  </model>

  <model>
    <name>G1000-panel</name>
    <path>Aircraft/KingAir-350/Models/G1000-panel.ac</path>
  </model>

  <model>
    <name>G1000-PFD</name>
    <path>Aircraft/Instruments-3d/FG1000/GDU104X/GDU-1044B.1.xml</path>
    <offsets>
      <x-m>-4.610</x-m>
      <y-m>-0.425</y-m>
      <z-m> 0.165</z-m>
    </offsets>
  </model>

  <model>
    <name>G1000-MFD</name>
    <path>Aircraft/Instruments-3d/FG1000/GDU104X/GDU-1044B.2.xml</path>
    <offsets>
      <x-m>-4.610</x-m>
      <y-m> 0.010</y-m>
      <z-m> 0.165</z-m>
    </offsets>
  </model>

  <model>
    <name>G1000-PFD2</name>
    <path>Aircraft/Instruments-3d/FG1000/GDU104X/GDU-1044B.3.xml</path>
    <offsets>
      <x-m>-4.610</x-m>
      <y-m> 0.445</y-m>
      <z-m> 0.165</z-m>
    </offsets>
  </model>

  <animation>
    <type>select</type>
    <object-name>G1000-panel</object-name>
    <object-name>G1000-PFD2</object-name>
    <condition>
      <property>sim/model/g1000/enabled</property>
    </condition>
  </animation>

  <!-- fine positioning from the property browser -->
  <animation>
    <type>translate</type>
    <object-name>G1000-PFD</object-name>
    <property>sim/model/g1000/pfd/dx-m</property>
    <axis><x>1</x><y>0</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>G1000-PFD</object-name>
    <property>sim/model/g1000/pfd/dy-m</property>
    <axis><x>0</x><y>1</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>G1000-PFD</object-name>
    <property>sim/model/g1000/pfd/dz-m</property>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>G1000-MFD</object-name>
    <property>sim/model/g1000/mfd/dx-m</property>
    <axis><x>1</x><y>0</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>G1000-MFD</object-name>
    <property>sim/model/g1000/mfd/dy-m</property>
    <axis><x>0</x><y>1</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>G1000-MFD</object-name>
    <property>sim/model/g1000/mfd/dz-m</property>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>G1000-PFD2</object-name>
    <property>sim/model/g1000/pfd2/dx-m</property>
    <axis><x>1</x><y>0</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>G1000-PFD2</object-name>
    <property>sim/model/g1000/pfd2/dy-m</property>
    <axis><x>0</x><y>1</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>G1000-PFD2</object-name>
    <property>sim/model/g1000/pfd2/dz-m</property>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>

</PropertyList>
