<?xml version="1.0" encoding="UTF-8"?>
<!--
  King Air 350ER "G1000" variant (KingAir-350ER-G1000-set.xml): the standard model with the Collins Pro Line Fusion
  style flight deck of Models/Fusion/fusion-cockpit.xml (glareshield, flight guidance panel, standby display,
  three 14-in widescreen displays showing the FG1000 pages, audio panels, display control strip, lower panels).
  The parts of the classic cockpit it replaces are hidden by a select animation at the end of Models/flightdeck.xml
  (sim/model/fusion/cockpit, set in the -set file).
  The cockpit is generated by the scripts of Tools/fusion (see Docs/Fusion-cockpit.md).
-->
<PropertyList>

  <model>
    <name>KingAir</name>
    <path>Aircraft/KingAir-350/Models/KingAir.xml</path>
  </model>

  <model>
    <name>FusionCockpit</name>
    <path>Aircraft/KingAir-350/Models/Fusion/fusion-cockpit.xml</path>
  </model>

  <animation>
    <type>range</type>
    <object-name>FusionCockpit</object-name>
    <min-m>0</min-m>
    <max-m>100</max-m>
  </animation>

</PropertyList>
